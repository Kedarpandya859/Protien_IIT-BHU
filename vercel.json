{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "agentic": {
      "root": "agentic",
      "framework": "vite"
    },
    "microdrama": {
      "root": "microdrama",
      "framework": "vite"
    },
    "personalisedonboarding": {
      "root": "Personalised onboarding",
      "framework": "vite"
    },
    "summarizer_compare_bundling": {
      "root": "Summarizer_compare_bundling",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/agentic/(.*)",
      "destination": {
        "service": "agentic"
      }
    },
    {
      "source": "/agentic",
      "destination": {
        "service": "agentic"
      }
    },
    {
      "source": "/microdrama/(.*)",
      "destination": {
        "service": "microdrama"
      }
    },
    {
      "source": "/microdrama",
      "destination": {
        "service": "microdrama"
      }
    },
    {
      "source": "/onboarding/(.*)",
      "destination": {
        "service": "personalisedonboarding"
      }
    },
    {
      "source": "/onboarding",
      "destination": {
        "service": "personalisedonboarding"
      }
    },
    {
      "source": "/summarizer/(.*)",
      "destination": {
        "service": "summarizer_compare_bundling"
      }
    },
    {
      "source": "/summarizer",
      "destination": {
        "service": "summarizer_compare_bundling"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
